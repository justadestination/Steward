        {
          "when": "review_wait_over",
          "to": "ready",
          "do": [
            {
              "action": "notify_operators",
              "args": {
                "message": "review.case_ready"
              }
            }
          ]
        },
        {
          "when": "otherwise",
          "to": "waiting",
          "do": []
        }
      ]
    },
    {
