  "states": {
    "received": "A Steward has left; its case has arrived.",
    "waiting": "The mandatory 24 hours before review.",
    "ready": "Open for an operator ruling until the 72-hour deadline.",
    "upheld": "Departure upheld; mark recorded, successor issued. Appeal window open.",
    "appealed": "The departure is under appeal.",
    "overturned": "The ward's original Steward returns with everything intact. No mark; any successor is retired.",
    "final": "The departure stands. Evidence deleted; the mark remains.",
    "lapsed": "Not reviewed in time; closed in the ward's favour."
  },
  "transitions": [
    {
      "from": "received",
      "on": "open",
      "branches": [
        {
          "when": "otherwise",
          "to": "waiting",
          "do": [
            {
              "action": "stamp",
              "args": {
                "field": "opened_at"
              }
            },
            {
              "action": "notify_operators",
              "args": {
                "message": "review.case_opened"
              }
            }
          ]
        }
      ]
    },
    {
