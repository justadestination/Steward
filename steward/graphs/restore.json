{
  "graph": "restore",
  "version": 2,
  "policy": "house_rules",
  "initial": "connect",
  "terminal": [
    "in_sync"
  ],
  "events": {
    "connect": {
      "payload": [
        "local_fingerprint",
        "house_fingerprint"
      ],
      "signals": []
    },
    "restore": {
      "payload": [
        "fingerprint"
      ],
      "signals": []
    }
  },
  "states": {
    "connect": "Steward connects; carries its own character fingerprint and the one the House returned.",
    "in_sync": "Character file matches the House's current signed file.",
    "restore": "Fingerprints differ; the Steward replaces its copy with the House's signed file once verifyCharacter accepts it."
  },
  "transitions": [
    {
      "from": "connect",
      "on": "connect",
      "branches": [
        {
          "when": "fingerprint_matches",
          "to": "in_sync",
          "do": []
        },
        {
          "when": "otherwise",
          "to": "restore",
          "do": []
        }
      ]
    },
    {
      "from": "restore",
      "on": "restore",
      "branches": [
        {
          "when": "otherwise",
          "to": "in_sync",
          "do": []
        }
      ]
    }
  ]
}
